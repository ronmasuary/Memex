{
  "name": "memex",
  "version": "0.0.0",
  "description": "A git-backed, markdown-based knowledge base exposed to AI agents over MCP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "setup": "npm install && npm --prefix web install && npm run build:all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "memex": "dist/cli.js",
    "memex-mcp": "dist/mcp.js"
  }
}
